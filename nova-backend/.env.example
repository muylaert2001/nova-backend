# ─────────────────────────────────────────────
#  NOVA Backend — Environment Variables
#  Copy this to .env and fill in your values
#  NEVER commit .env to git
# ─────────────────────────────────────────────

# Server
PORT=3001
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars
FRONTEND_URL=https://claude.ai

# ── Google (Gmail + Calendar) ──
# Get these from: https://console.cloud.google.com
# Create project → Enable Gmail API + Calendar API → OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
# For production: https://your-railway-app.railway.app/auth/google/callback

# ── Spotify ──
# Get these from: https://developer.spotify.com/dashboard
# Create app → Settings → copy Client ID and Secret
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3001/auth/spotify/callback
# For production: https://your-railway-app.railway.app/auth/spotify/callback

# ── Slack ──
# Get these from: https://api.slack.com/apps
# Create app → OAuth & Permissions → copy credentials
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:3001/auth/slack/callback
# For production: https://your-railway-app.railway.app/auth/slack/callback

# ── Microsoft (Outlook + Teams) ──
# Get these from: https://portal.azure.com
# Azure Active Directory → App registrations → New registration
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/microsoft/callback
# For production: https://your-railway-app.railway.app/auth/microsoft/callback
